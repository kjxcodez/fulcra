# Fulcra Monorepo Environment Variables
#
# Copy this file to .env.local for local overrides:
#   cp .env.example .env.local
#
# SECURITY WARNING:
#   Never commit .env, .env.local, or any secret-bearing environment files to version control.
#   All local environment files are ignored by .gitignore.

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API Configuration
PORT=4000
API_ENV=local
WEB_ORIGIN=http://localhost:3000
API_VERSION=0.1.0

# Database Configuration (Neon Serverless PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Trigger.dev Background Execution (Managed Workflows)
# Project identifier in Trigger.dev
TRIGGER_PROJECT_ID=fulcra-trigger-local
# Secret API key for Trigger.dev (keep secret; never commit)
TRIGGER_SECRET_KEY=

# Browser Automation (Generic Managed Browser Provider)
# Provider type: "mock" (default for offline/tests), "remote" (generic managed remote endpoint), "local" (local Chromium)
BROWSER_PROVIDER=mock
# Generic remote browser WebSocket / CDP endpoint (connects via standard CDP/WebSocket)
# Note: The production managed browser provider has not yet been selected.
BROWSER_PROVIDER_URL=
# Credential/token required by the configured managed browser endpoint, when applicable (keep secret; never commit)
BROWSER_PROVIDER_TOKEN=
# Timeouts in milliseconds
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000

# Environment Mode
NODE_ENV=development
