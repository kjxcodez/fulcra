# Fulcra Monorepo Environment Variables
#
# Copy this file to .env.local for local overrides:
#   cp .env.example .env.local
#
# SECURITY WARNING:
#   Never commit .env, .env.local, or any secret-bearing environment files to version control.
#   All local environment files are ignored by .gitignore.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment Mode
NODE_ENV=development
