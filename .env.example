# Fulcra Monorepo Environment Variables
#
# Copy this file to .env.local for local overrides:
#   cp .env.example .env.local
#
# SECURITY WARNING:
#   Never commit .env, .env.local, or any secret-bearing environment files to version control.
#   All local environment files are ignored by .gitignore.

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API Configuration
PORT=4000
API_ENV=local
WEB_ORIGIN=http://localhost:3000
API_VERSION=0.1.0

# Environment Mode
NODE_ENV=development
